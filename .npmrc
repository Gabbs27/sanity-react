# @blocknote/mantine@0.49.0 declares a peer of @mantine/core@^8.3.11, but this
# project runs @mantine/core@9. npm refuses that install by default, so every
# clean environment — Vercel, CI, a new machine — fails on `npm install` with
# ERESOLVE, while this repo has always installed fine locally only because the
# maintainer's *global* ~/.npmrc happens to set legacy-peer-deps=true.
#
# Putting it here makes the project build the same way everywhere instead of
# depending on machine-level config that is not in the repo. A clean install
# with this file resolves to the exact versions already in package-lock.json
# (@mantine/core 9.1.1, @blocknote/mantine 0.49.0), so nothing about the
# shipped tree changes.
#
# This silences the conflict, it does not resolve it: BlockNote is being run
# against a Mantine major it does not claim to support, and only the admin
# editor at /admin/write uses it. The real fix is to align the two versions.
legacy-peer-deps=true
